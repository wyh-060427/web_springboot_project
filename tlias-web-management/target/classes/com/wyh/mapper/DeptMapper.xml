<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wyh.mapper.DeptMapper">
    <update id="updateDate">
        update dept set name=#{name},update_time=#{updateTime} where id=#{id};
    </update>

    <!--    <select id="findAll" resultType="com.wyh.pojo.User">-->
<!--        select id,username,password,name,age from user-->
<!--    </select>-->
    <select id="findAll" resultType="com.wyh.pojo.Dept">
        select id,name,create_time,update_time from dept order by update_time desc;
    </select>
    <select id="getId" resultType="com.wyh.pojo.Dept">
        select * from dept where id=#{id};
    </select>
    <delete id="deleteID">
        delete from dept where id=#{id};
    </delete>
    <insert id="add">
        insert into dept (name,create_time,update_time) values (#{name},#{createTime},#{updateTime});
    </insert>
</mapper>
